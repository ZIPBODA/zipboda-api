# 로컬 개발용 예시. 복사해 .env로 쓴다 — 실제 비밀값은 .env에만 둔다(.gitignore)
NODE_ENV=development
PORT=4000

# docker compose의 db 서비스(호스트 5433)를 가리킨다
DATABASE_URL="postgresql://zipboda:zipboda@localhost:5433/zipboda?schema=public"
# e2e 테스트 전용 DB — 테스트가 표를 비우고 다시 채운다
TEST_DATABASE_URL="postgresql://zipboda:zipboda@localhost:5433/zipboda_test?schema=public"

# 쉼표로 나눈 허용 출처. web 개발 서버(3000·3001)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 공공 청약 수집(pnpm sync:lh). 공공데이터포털 인증키(Decoding) — LH 공고 목록·상세·공급정보 API 활용 신청 필요
PUBLIC_DATA_SERVICE_KEY=
# 단지 좌표(카카오 로컬 REST 키). 서버 전용 — web의 NEXT_PUBLIC_ 키와 다르다. 비우면 좌표를 채우지 않는다
KAKAO_REST_API_KEY=
